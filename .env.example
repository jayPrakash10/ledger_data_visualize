# FUTURE API: base URL of the real backend. Currently UNUSED (services return mock data).
NEXT_PUBLIC_API_BASE_URL=

# Set to "false" once service files call the real API.
NEXT_PUBLIC_USE_MOCK=true

# Mock behaviour: artificial latency in ms, and the chance (0-1) a call fails (to demo error states).
NEXT_PUBLIC_MOCK_DELAY_MS=450
NEXT_PUBLIC_MOCK_FAILURE_RATE=0
